# ─── Game Configuration ───────────────────────────────────────
# World seed for procedural city generation (optional, random if empty)
VITE_WORLD_SEED=42

# City grid size (e.g., 6 for 6x6 blocks)
VITE_CITY_GRID_SIZE=6

# Debug mode (shows physics wireframes, FPS counter, coords)
VITE_DEBUG=false

# ─── Development ──────────────────────────────────────────────
# Dev server port
VITE_PORT=3000
